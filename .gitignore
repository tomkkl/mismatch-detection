.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.idea/

# Data and model outputs. The training dataset `full` and the LLM cache (~25 MB) are
# committed so teammates don't have to regenerate; everything else stays local.
data/raw/*
data/generated/*
data/splits/*
!data/**/.gitkeep
!data/generated/full/
!data/generated/llm_cache/
!data/generated/rung2-opus/
!data/raw/rung3/
!data/generated/coverage-bugs/
!data/splits/full/
# Training results and SLURM logs are committed; model weights (~476 MB each) are over
# GitHub's 100 MB limit and stay local / on CARC.
checkpoints/**/*.safetensors
probes/aa_run/*
!probes/aa_run/.gitkeep

.env
